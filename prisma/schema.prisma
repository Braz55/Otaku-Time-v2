// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum TrackingStatus {
  WATCHING
  PLANNED
  COMPLETED
  PAUSED
  DROPPED
}

model User {
  id                Int           @id @default(autoincrement())
  nome              String
  email             String        @unique
  password          String
  preferredLanguage String        @default("PT")
  theme             String        @default("dark")
  showAdultContent  Boolean       @default(false)
  tokenVersion      Int           @default(1)
  iconUrl           String?
  bannerUrl         String?
  preferences       Json?         @default("{}")
  animes            UserAnime[]
  mangas            UserManga[]
  sessions          ChatSession[]
  topFavorites      UserTopFavorite[]
  statistics        UserStatistics?
  achievements      UserAchievement[]
}

model Anime {
  id                  Int         @id // Usar o ID da AniList diretamente
  titulo              String
  statusLancamento    String?
  descricao           String?
  generos             String?
  capaUrl             String?
  numEpisodiosTotal   Int?
  proximoEpisodio     Int?        // Número do próximo episódio (se disponível)
  proximoEpisodioData DateTime? // Data e hora exata do lançamento do próximo episódio
  dataLancamento      DateTime?
  temporada           String?
  ano                 Int?
  linksExternos       String?     // JSON string com os links oficiais (MangaPlus, Lezhin, etc.)
  utilizadores        UserAnime[]
  updatedAt           DateTime    @default(now()) @updatedAt
}

model UserAnime {
  id         Int            @id @default(autoincrement())
  epAtual    Int            @default(0)
  status     TrackingStatus @default(PLANNED)
  prioridade Int            @default(5)
  linksPersonalizados String?
  userId     Int
  animeId    Int
  user       User           @relation(fields: [userId], references: [id])
  anime      Anime          @relation(fields: [animeId], references: [id])
  updatedAt  DateTime       @default(now()) @updatedAt

  @@unique([userId, animeId])
}

model Manga {
  id                    Int         @id // Usar o ID da AniList diretamente
  titulo                String
  statusLancamento      String?
  numCapitulosTotal     Float?
  capaUrl               String?
  generos               String?
  autor                 String?
  descricao             String?
  proximoCapituloData   DateTime? // Data prevista para o próximo capítulo
  proximoCapituloNumero Float?    // Número do próximo capítulo
  linksExternos         String?     // JSON string com os links oficiais
  utilizadores          UserManga[]
  updatedAt             DateTime    @default(now()) @updatedAt
}

model UserManga {
  id         Int            @id @default(autoincrement())
  capAtual   Float          @default(0)
  status     TrackingStatus @default(PLANNED)
  prioridade Int            @default(5)
  linksPersonalizados String?
  userId     Int
  mangaId    Int
  user       User           @relation(fields: [userId], references: [id])
  manga      Manga          @relation(fields: [mangaId], references: [id])
  updatedAt  DateTime       @default(now()) @updatedAt

  @@unique([userId, mangaId])
}

model ChatSession {
  id        Int           @id @default(autoincrement())
  titulo    String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  userId    Int
  user      User          @relation(fields: [userId], references: [id])
  messages  ChatMessage[]
}

model ChatMessage {
  id        Int         @id @default(autoincrement())
  role      String      // 'user' ou 'assistant'
  content   String
  createdAt DateTime    @default(now())
  sessionId Int
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model SyncLog {
  id        Int      @id @default(autoincrement())
  timestamp DateTime @default(now())
  status    String   // 'SUCCESS' or 'FAILED'
  details   String?  // Description of what was synced or error details
}

enum MediaType {
  ANIME
  MANGA
}

model UserTopFavorite {
  id             Int       @id @default(autoincrement())
  userId         Int
  anilistMediaId Int
  mediaType      MediaType
  rankPosition   Int       // 1, 2 ou 3
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, rankPosition])
  @@unique([userId, anilistMediaId, mediaType])
}

model UserStatistics {
  userId               Int   @id
  totalAnimeCompleted  Int   @default(0)
  totalEpisodesWatched Int   @default(0)
  totalMangaRead       Int   @default(0)
  daysWasted           Float @default(0.0)
  user                 User  @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Achievement {
  id            Int               @id @default(autoincrement())
  name          String
  description   String
  badgeImageUrl String?
  users         UserAchievement[]
}

model UserAchievement {
  userId        Int
  achievementId Int
  unlockedAt    DateTime          @default(now())
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement   Achievement       @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@id([userId, achievementId])
}