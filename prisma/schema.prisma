// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

enum TrackingStatus {
  WATCHING
  PLANNED
  COMPLETED
  PAUSED
  DROPPED
}

model User {
  id       Int         @id @default(autoincrement())
  nome     String
  email    String      @unique
  password String
  animes   UserAnime[]
  mangas   UserManga[]
}

model Anime {
  id                Int         @id // Usar o ID da AniList diretamente
  titulo            String
  statusLancamento  String?
  descricao         String?
  generos           String?
  capaUrl           String?
  numEpisodiosTotal Int?
  proximoEpisodio   Int?
  dataLancamento    DateTime?
  temporada         String?
  ano               Int?
  utilizadores      UserAnime[]
}

model UserAnime {
  id      Int            @id @default(autoincrement())
  epAtual Int            @default(0)
  status  TrackingStatus @default(PLANNED)
  userId  Int
  animeId Int
  user    User           @relation(fields: [userId], references: [id])
  anime   Anime          @relation(fields: [animeId], references: [id])

  @@unique([userId, animeId])
}

model Manga {
  id                Int         @id // Usar o ID da AniList diretamente
  titulo            String
  statusLancamento  String?
  numCapitulosTotal Float?
  capaUrl           String?
  generos           String?
  autor             String?
  descricao         String?
  utilizadores      UserManga[]
}

model UserManga {
  id         Int            @id @default(autoincrement())
  capAtual   Float          @default(0)
  status     TrackingStatus @default(PLANNED)
  prioridade Int            @default(5)
  userId     Int
  mangaId    Int
  user       User           @relation(fields: [userId], references: [id])
  manga      Manga          @relation(fields: [mangaId], references: [id])

  @@unique([userId, mangaId])
}