// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

enum TrackingStatus {
  WATCHING
  PLANNED
  COMPLETED
  PAUSED
  DROPPED
}

model User {
  id                Int           @id @default(autoincrement())
  nome              String
  email             String        @unique
  password          String
  preferredLanguage String        @default("PT")
  theme             String        @default("dark")
  showAdultContent  Boolean       @default(false)
  tokenVersion      Int           @default(1)
  tipoConta         String        @default("padrao")
  iconUrl           String?
  bannerUrl         String?
  preferences       Json?         @default("{}")
  animes            UserAnime[]
  mangas            UserManga[]
  sessions          ChatSession[]
  topFavorites      UserTopFavorite[]
  statistics        UserStatistics?
  achievements      UserAchievement[]
  subscription      UserSubscription?
  redeemedCodes     GiftCode[]
  ratings           UserRating[]
  comments          Comment[]
  commentLikes      CommentLike[]
  customLists       CustomList[]
  notifications     Notification[]
}

model Anime {
  id                  Int         @id // Usar o ID da AniList/TMDB diretamente
  titulo              String
  statusLancamento    String?
  descricao           String?
  generos             Json?
  capaUrl             String?
  numEpisodiosTotal   Int?
  proximoEpisodio     Int?        // Número do próximo episódio (se disponível)
  proximoEpisodioData DateTime? // Data e hora exata do lançamento do próximo episódio
  dataLancamento      DateTime?
  temporada           String?
  ano                 Int?
  paisOrigem          String?
  formato             String?
  tipo                String      @default("ANIME")
  materialOrigem      String?
  linksExternos       String?     // JSON string com os links oficiais
  utilizadores        UserAnime[]
  customListItems     CustomListItem[]
  episodesList        Json?       // Lista de todos os episódios em formato JSON
  numEpisodiosAired   Int?
  ultimoEpisodioEstreadoData DateTime?
  updatedAt           DateTime    @default(now()) @updatedAt
}

model UserAnime {
  id         Int            @id @default(autoincrement())
  seasonAtual Int           @default(1)
  epAtual    Int            @default(0)
  status     TrackingStatus @default(PLANNED)
  prioridade Int            @default(5)
  linksPersonalizados String?
  notas      String?
  userId     Int
  animeId    Int
  user       User           @relation(fields: [userId], references: [id])
  anime      Anime          @relation(fields: [animeId], references: [id])
  wasDropped Boolean        @default(false)
  lastProgressUpdate DateTime?
  watchedSpecials Json?        @default("[]")
  updatedAt  DateTime       @default(now()) @updatedAt

  @@unique([userId, animeId])
}

model Manga {
  id                    Int         @id // Usar o ID da AniList diretamente
  titulo                String
  statusLancamento      String?
  numCapitulosTotal     Float?
  capaUrl               String?
  generos               Json?
  paisOrigem            String?
  formato               String?
  materialOrigem        String?
  descricao             String?
  proximoCapituloData   DateTime? // Data prevista para o próximo capítulo
  proximoCapituloNumero Float?    // Número do próximo capítulo
  linksExternos         String?     // JSON string com os links oficiais
  utilizadores          UserManga[]
  customListItems       CustomListItem[]
  updatedAt             DateTime    @default(now()) @updatedAt
}

model UserManga {
  id         Int            @id @default(autoincrement())
  capAtual   Float          @default(0)
  status     TrackingStatus @default(PLANNED)
  prioridade Int            @default(5)
  linksPersonalizados String?
  notas      String?
  userId     Int
  mangaId    Int
  user       User           @relation(fields: [userId], references: [id])
  manga      Manga          @relation(fields: [mangaId], references: [id])
  wasDropped Boolean        @default(false)
  lastProgressUpdate DateTime?
  updatedAt  DateTime       @default(now()) @updatedAt

  @@unique([userId, mangaId])
}

model ChatSession {
  id        Int           @id @default(autoincrement())
  titulo    String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  userId    Int
  user      User          @relation(fields: [userId], references: [id])
  messages  ChatMessage[]
}

model ChatMessage {
  id        Int         @id @default(autoincrement())
  role      String      // 'user' ou 'assistant'
  content   String
  createdAt DateTime    @default(now())
  sessionId Int
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model SyncLog {
  id        Int      @id @default(autoincrement())
  timestamp DateTime @default(now())
  status    String   // 'SUCCESS' or 'FAILED'
  details   String?  // Description of what was synced or error details
}

enum MediaType {
  ANIME
  MANGA
}

model UserTopFavorite {
  id             Int       @id @default(autoincrement())
  userId         Int
  anilistMediaId Int
  mediaType      MediaType
  rankPosition   Int       // 1, 2 ou 3
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, mediaType, rankPosition])
  @@unique([userId, anilistMediaId, mediaType])
}

model UserStatistics {
  userId               Int   @id
  totalAnimeCompleted  Int   @default(0)
  totalEpisodesWatched Int   @default(0)
  totalMangaRead       Int   @default(0)
  animeDaysWasted      Float @default(0.0)
  mangaDaysWasted      Float @default(0.0)
  user                 User  @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Achievement {
  id            Int               @id @default(autoincrement())
  name          String
  description   String
  badgeImageUrl String?
  rarity        String            @default("COMMON")
  users         UserAchievement[]
}

model UserAchievement {
  userId        Int
  achievementId Int
  unlockedAt    DateTime          @default(now())
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement   Achievement       @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@id([userId, achievementId])
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  EXPIRED
  PAST_DUE
}

model UserSubscription {
  id                     Int                @id @default(autoincrement())
  userId                 Int                @unique
  planType               String             @default("PREMIUM")
  status                 SubscriptionStatus @default(ACTIVE)
  startDate              DateTime           @default(now())
  currentPeriodEnd       DateTime
  externalSubscriptionId String?
  user                   User               @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model GiftCode {
  id                 Int       @id @default(autoincrement())
  code               String    @unique
  durationDays       Int
  isUsed             Boolean   @default(false)
  redeemedByUserId   Int?
  redeemedAt         DateTime?
  expiresAt          DateTime?
  redeemedByUser     User?     @relation(fields: [redeemedByUserId], references: [id], onDelete: SetNull)
}

model Media {
  id                Int          @id
  avaliacao_base    Float
  total_votos_users Int          @default(0)
  soma_notas_users  Float        @default(0)
  avaliacao_geral   Float
  ratings           UserRating[]

  @@map("Media")
}

model UserRating {
  id      Int   @id @default(autoincrement())
  userId  Int   @map("user_id")
  mediaId Int   @map("media_id")
  score   Float

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  media Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([userId, mediaId])
  @@map("User_Rating")
}

model Comment {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  mediaId   Int      @map("media_id")
  text      String
  likes     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  likesList CommentLike[]

  @@map("User_Comment")
}

model GenreTag {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  type        String  // 'GENRE' ou 'TAG'
  category    String
  subcategory String
  isAdult     Boolean @default(false)
  isExposed   Boolean @default(false)
}

model CustomList {
  id          Int              @id @default(autoincrement())
  name        String
  description String?
  coverUrl    String?
  isPublic    Boolean          @default(false)
  criteria    Json?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @default(now()) @updatedAt
  userId      Int
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  items       CustomListItem[]
}

model CustomListItem {
  id             Int        @id @default(autoincrement())
  listId         Int
  anilistMediaId Int
  mediaType      MediaType
  position       Int
  addedAt        DateTime   @default(now())
  animeId        Int?
  mangaId        Int?
  list           CustomList @relation(fields: [listId], references: [id], onDelete: Cascade)
  anime          Anime?     @relation(fields: [animeId], references: [id], onDelete: SetNull)
  manga          Manga?     @relation(fields: [mangaId], references: [id], onDelete: SetNull)

  @@unique([listId, anilistMediaId, mediaType])
  @@index([listId, position])
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  title     String
  message   String
  type      String   // 'ANIME' | 'MANGA' | 'SYSTEM'
  mediaId   Int?     // AniList ID of the anime/manga
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CommentLike {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  commentId Int      @map("comment_id")
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, commentId])
  @@map("Comment_Like")
}


