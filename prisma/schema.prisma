// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

enum TrackingStatus {
  WATCHING
  PLANNED
  COMPLETED
  PAUSED
  DROPPED
}

model User {
  id                Int           @id @default(autoincrement())
  nome              String
  email             String        @unique
  password          String
  preferredLanguage String        @default("PT")
  theme             String        @default("dark")
  showAdultContent  Boolean       @default(false)
  tokenVersion      Int           @default(1)
  tipoConta         String        @default("normal")
  iconUrl           String?
  bannerUrl         String?
  preferences       Json?         @default("{}")
  animes            UserAnime[]
  mangas            UserManga[]
  topFavorites      UserTopFavorite[]
  statistics        UserStatistics?
  ratings           UserRating[]
  comments          Comment[]
  commentLikes      CommentLike[]
  customLists       CustomList[]
  notifications     Notification[]
}

// L-23: o ID do TMDB sozinho não identifica a obra, porque séries e filmes têm numerações
// separadas. A chave é o par (fonte, id), com fonte TMDB_TV ou TMDB_MOVIE (CHECK na migração).
model Anime {
  id                  Int         // ID externo da obra na fonte
  fonte               MediaSource
  titulo              String
  statusLancamento    String?
  descricao           String?
  generos             Json?
  capaUrl             String?
  bannerUrl           String?
  numEpisodiosTotal   Int?
  proximoEpisodio     Int?        // Número do próximo episódio (se disponível)
  proximoEpisodioData DateTime? // Data e hora exata do lançamento do próximo episódio
  dataLancamento      DateTime?
  temporada           String?
  ano                 Int?
  paisOrigem          String?
  formato             String?
  tipo                String      @default("ANIME")
  materialOrigem      String?
  linksExternos       String?     // JSON string com os links oficiais
  utilizadores        UserAnime[]
  customListItems     CustomListItem[]
  episodesList        Json?       // Lista de todos os episódios em formato JSON
  numEpisodiosAired   Int?
  ultimoEpisodioEstreadoData DateTime?
  updatedAt           DateTime    @default(now()) @updatedAt

  @@id([fonte, id])
}

model UserAnime {
  id         Int            @id @default(autoincrement())
  seasonAtual Int           @default(1)
  epAtual    Int            @default(0)
  status     TrackingStatus @default(PLANNED)
  prioridade Int            @default(5)
  linksPersonalizados String?
  notas      String?
  userId     Int
  animeFonte MediaSource
  animeId    Int
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade) // L-26
  anime      Anime          @relation(fields: [animeFonte, animeId], references: [fonte, id])
  wasDropped Boolean        @default(false)
  lastProgressUpdate DateTime?
  watchedSpecials Json?        @default("[]")
  capaPersonalizada   String? // Capa escolhida pelo utilizador; null = usa a do catálogo
  bannerPersonalizado String? // Banner escolhido pelo utilizador; null = usa o do catálogo
  updatedAt  DateTime       @default(now()) @updatedAt

  @@unique([userId, animeFonte, animeId])
}

// O manga vem sempre da AniList: a sua chave natural é (ANILIST, id), por isso basta o id.
model Manga {
  id                    Int         @id // ID da AniList
  titulo                String
  statusLancamento      String?
  numCapitulosTotal     Float?
  capaUrl               String?
  bannerUrl             String?
  generos               Json?
  paisOrigem            String?
  formato               String?
  materialOrigem        String?
  descricao             String?
  proximoCapituloData   DateTime? // Data prevista para o próximo capítulo
  proximoCapituloNumero Float?    // Número do próximo capítulo
  linksExternos         String?     // JSON string com os links oficiais
  utilizadores          UserManga[]
  customListItems       CustomListItem[]
  updatedAt             DateTime    @default(now()) @updatedAt
}

model UserManga {
  id         Int            @id @default(autoincrement())
  capAtual   Float          @default(0)
  status     TrackingStatus @default(PLANNED)
  prioridade Int            @default(5)
  linksPersonalizados String?
  notas      String?
  userId     Int
  mangaId    Int
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade) // L-26
  manga      Manga          @relation(fields: [mangaId], references: [id])
  wasDropped Boolean        @default(false)
  lastProgressUpdate DateTime?
  capaPersonalizada   String? // Capa escolhida pelo utilizador; null = usa a do catálogo
  bannerPersonalizado String? // Banner escolhido pelo utilizador; null = usa o do catálogo
  updatedAt  DateTime       @default(now()) @updatedAt

  @@unique([userId, mangaId])
}

model SyncLog {
  id        Int      @id @default(autoincrement())
  timestamp DateTime @default(now())
  status    String   // 'RUNNING', 'SUCCESS', 'PARTIAL' (algumas obras falharam) ou 'FAILED'
  details   String?  // Description of what was synced or error details
}

enum MediaType {
  ANIME
  MANGA
}

// L-23/L-24/L-25: de onde vem o ID de uma obra. Com o ID externo forma a chave natural da obra.
// ANILIST = manga; TMDB_TV / TMDB_MOVIE = anime (séries e filmes têm numerações separadas no TMDB).
enum MediaSource {
  ANILIST
  TMDB_TV
  TMDB_MOVIE
}

// mediaType é a prateleira do destaque (top 3 de anime e top 3 de manga). Um CHECK na migração
// garante que bate com a fonte.
model UserTopFavorite {
  id           Int         @id @default(autoincrement())
  userId       Int
  fonte        MediaSource
  mediaId      Int
  mediaType    MediaType
  rankPosition Int         // 1, 2 ou 3
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, mediaType, rankPosition])
  @@unique([userId, fonte, mediaId])
}

model UserStatistics {
  userId               Int   @id
  totalAnimeCompleted  Int   @default(0)
  totalEpisodesWatched Int   @default(0)
  totalMangaRead       Int   @default(0)
  animeDaysWasted      Float @default(0.0)
  mangaDaysWasted      Float @default(0.0)
  user                 User  @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Avaliação agregada de uma obra, identificada pelo par (fonte, id) (L-23, L-24).
model Media {
  id                Int
  fonte             MediaSource
  avaliacao_base    Float
  total_votos_users Int          @default(0)
  soma_notas_users  Float        @default(0)
  avaliacao_geral   Float
  ratings           UserRating[]

  @@id([fonte, id])
  @@map("Media")
}

model UserRating {
  id      Int   @id @default(autoincrement())
  userId  Int   @map("user_id")
  fonte     MediaSource @map("media_source")
  mediaId   Int         @map("media_id")
  score     Float

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  media Media @relation(fields: [fonte, mediaId], references: [fonte, id], onDelete: Cascade)

  @@unique([userId, fonte, mediaId])
  @@map("User_Rating")
}

model Comment {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  fonte     MediaSource @map("media_source") // L-23, L-24
  mediaId   Int         @map("media_id")
  text      String
  likes     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  likesList CommentLike[]

  @@index([fonte, mediaId])
  @@map("User_Comment")
}

model GenreTag {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  type        String  // 'GENRE' ou 'TAG'
  category    String
  subcategory String
  isAdult     Boolean @default(false)
  isExposed   Boolean @default(false)
}

model CustomList {
  id          Int              @id @default(autoincrement())
  name        String
  description String?
  coverUrl    String?
  criteria    Json?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @default(now()) @updatedAt
  userId      Int
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  items       CustomListItem[]
}

// A obra é identificada pela fonte e por animeId ou mangaId (L-23, L-28). Um CHECK na migração
// garante que só a FK que corresponde à fonte está preenchida.
model CustomListItem {
  id        Int         @id @default(autoincrement())
  listId    Int
  fonte     MediaSource
  position  Int
  addedAt   DateTime    @default(now())
  animeId   Int?
  mangaId   Int?
  list      CustomList  @relation(fields: [listId], references: [id], onDelete: Cascade)
  anime     Anime?      @relation(fields: [fonte, animeId], references: [fonte, id], onDelete: Cascade)
  manga     Manga?      @relation(fields: [mangaId], references: [id], onDelete: Cascade)

  @@unique([listId, fonte, animeId])
  @@unique([listId, mangaId])
  @@index([listId, position])
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  title     String
  message   String
  type      String   // 'ANIME' | 'MANGA' | 'SYSTEM'
  fonte     MediaSource? // Fonte da obra (L-23); null nas notificações sem obra
  mediaId   Int?     // ID externo da obra na fonte
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CommentLike {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  commentId Int      @map("comment_id")
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, commentId])
  @@map("Comment_Like")
}


